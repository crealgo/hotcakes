{
  "extends": "./node_modules/@hotcakes/core/lib/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@components/*": [
        "./src/components-new/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@configs/*": [
        "./src/configs/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "out",
    "dist",
    ".next",
    "build",
    "scripts",
    "test-results"
  ],
  "include": [
    "next-env.d.ts",
    "**/*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx"
  ]
}
