{
  "name": "@hotcakes/ui-web-components",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./*": "./lib/*.js"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "clean": "rimraf dir",
    "build": "npm run clean && npm run build:package && npm run build:types",
    "build:package": "node esbuild.config.js",
    "build:types": "tsc --project tsconfig.build.json",
    "dev": "storybook dev -p 6006",
    "build:docs": "storybook build"
  },
  "devDependencies": {
    "@storybook/web-components-vite": "^10.0.8",
    "esbuild": "^0.27.0",
    "lit": "^3.3.1",
    "rimraf": "^6.1.2",
    "storybook": "^10.0.8",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  },
  "workspaces": [
    "package",
    "docs"
  ],
  "dependencies": {
    "@types/node": "^24.10.1"
  }
}
