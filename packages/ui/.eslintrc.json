{
	"env": {
		"browser": true,
		"es2021": true,
		"node": true
	},
	"extends": [
		"xo-typescript",
		"plugin:lit/recommended"
	],
	"rules": {
		"@typescript-eslint/class-literal-property-style": [
			"error",
			"fields"
		],
		"@typescript-eslint/consistent-type-definitions": "off",
		"@typescript-eslint/naming-convention": "off"
	},
	"parserOptions": {
		"ecmaVersion": "latest",
		"sourceType": "module"
	}
}
