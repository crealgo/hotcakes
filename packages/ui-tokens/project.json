{
  "name": "ui-tokens",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "tags": [
    "publishable"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm build",
        "cwd": "{projectRoot}"
      }
    },
    "nx-release-publish": {
      "dependsOn": [
        "build"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm publish --no-git-checks",
        "cwd": "{projectRoot}"
      }
    }
  }
}
