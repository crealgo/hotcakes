{
    "name": "eslint-config",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "tags": ["publishable"],
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "options": {
                "command": "tsc --build tsconfig.json",
                "cwd": "{projectRoot}"
            }
        },
        "nx-release-publish": {
            "dependsOn": ["build"],
            "executor": "nx:run-commands",
            "options": {
                "command": "node {workspaceRoot}/scripts/publish.mjs",
                "cwd": "{projectRoot}"
            }
        }
    }
}
