{
  "name": "@hotcakes/rehype-table-of-contents",
  "type": "module",
  "version": "1.9.0",
  "author": "Crealgo, LLC <hello.crealgo@gmail.com> (https://crealgo.com)",
  "description": "MDX plugin that (1) generates a table of contents based on headings tags found in the content, (2) converts the headings into links and (3) appends it to the mdx frontmatter",
  "exports": {
    "./package.json": "./package.json",
    ".": "./lib/index.js",
    "./*": "./lib/*.js",
    "./utils/*": "./lib/utils/*.js"
  },
  "files": [
    "lib/**",
    "LICENSE"
  ],
  "homepage": "https://crealgo.com",
  "license": "MIT",
  "keywords": [
    "table",
    "of",
    "contents",
    "table of contents",
    "rehype",
    "mdx",
    "headings",
    "anchors"
  ],
  "devDependencies": {
    "@types/estree": "~1.0.8",
    "@types/hast": "~3.0.4",
    "@types/mdast": "~4.0.4",
    "@types/unist": "~3.0.3",
    "hast": "~1.0.0",
    "publint": "catalog:",
    "typescript": "catalog:",
    "unified": "~11.0.5",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "change-case": "~5.4.4",
    "mdast-util-mdxjs-esm": "~2.0.1",
    "remark-frontmatter": "~5.0.0",
    "remark-mdx-frontmatter": "~5.2.0"
  }
}
