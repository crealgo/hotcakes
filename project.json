{
  "name": "hotcakes-core",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [
    "ui-react"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build-css"
      ],
      "options": {
        "command": "tsc --build"
      },
      "configurations": {
        "watch": {
          "args": "--watch"
        },
        "force": {
          "args": "--force"
        }
      }
    }
  }
}