{
  "name": "hotcakes-core",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build-css": {
      "executor": "nx:noop",
      "dependsOn": [
        "^build-css"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build-css"
      ],
      "options": {
        "command": "tsc --build"
      },
      "cache": false
    }
  }
}