{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "main",
    "analytics": false,
    "release": {
        "projects": ["tag:publishable"],
        "version": {
            "conventionalCommits": true,
            "preserveLocalDependencyProtocols": false
        },
        "git": {
            "commit": true,
            "tag": true
        },
        "changelog": {
            "projectChangelogs": true
        },
        "projectsRelationship": "independent"
    },
    "workspaceLayout": {
        "appsDir": "apps",
        "libsDir": "packages"
    }
}
